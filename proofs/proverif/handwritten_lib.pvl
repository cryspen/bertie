(* The ClientHello message, as built by `client_hello` and taken apart by     *)
(* `set_client_hello_binder` and `parse_client_hello`.                        *)
fun model__client_hello_c(
      bitstring, (* client_randomness *)
      bitstring, (* session_id *)
      bitstring, (* server name / sni *)
      bitstring, (* kem_pk / gx *)
      bitstring, (* tkto *)
      bitstring, (* binder *)
      bitstring) (* trunc_len *)
      : bitstring [data].
